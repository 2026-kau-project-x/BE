# 복사해서 .env 로 쓰기 (.env 는 gitignore)
APP_ENV=local
DATABASE_URL=sqlite:///./projectx.db
# Postgres 예: postgresql+psycopg://projectx:비밀번호@localhost:5432/projectx
# AI 서비스 주소. 비워두면 Mock 사용. 로컬에서 AI 리포를 띄웠다면 http://localhost:8001
AI_SERVICE_URL=
# API 키 인증. 비우면 꺼짐. 설정하면 FE env.json 의 BE_API_KEY 와 같은 값이어야 한다
# API_KEY=
# AI 응답 대기 한도(초)
# AI_TIMEOUT_S=3
# 브라우저 CORS 허용 Origin 정규식 (기본: localhost 모든 포트). 운영에서는 실제 도메인으로 좁힐 것
# CORS_ORIGIN_REGEX=
